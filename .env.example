NODE_ENV=production
HOST=0.0.0.0
PORT=3210

# Embedded PostgreSQL (recommended for one-command deploys)
EMBEDDED_PG=true
EMBEDDED_PG_DATA_DIR=/var/lib/seqta-calendar/pg
# Local macOS/dev: EMBEDDED_PG_DATA_DIR=./data/pg
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_USER=seqta
EMBEDDED_PG_PASSWORD=seqta
EMBEDDED_PG_DATABASE=seqta_calendar
# EMBEDDED_PG_CREATE_USER=false

# External Postgres alternative:
# EMBEDDED_PG=false
# DATABASE_URL=postgresql://seqta:seqta@127.0.0.1:5432/seqta_calendar

# Real-Postgres RLS tests:
# EMBEDDED_PG=false
# DATABASE_URL_TEST=postgresql://leo@127.0.0.1:5432/seqta_calendar_test

DEFAULT_TIMEZONE=Australia/Sydney
PUBLIC_BASE_URL=https://timetable.leoze.top

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_PEPPER=
UID_SECRET=
# Required in production; must be different from TOKEN_PEPPER
SESSION_SECRET=

ALLOWED_ORIGINS=https://learn.masada.onseqtacloud.com

MAX_BODY_BYTES=2097152
MAX_LESSONS_PER_SYNC=2000
MAX_SYNC_RANGE_DAYS=120
CANCELLED_FEED_RETENTION_DAYS=14

LOG_LEVEL=info
TRUST_PROXY=true
SESSION_TTL_HOURS=168
COOKIE_SECURE=true
AUTH_DEV_LOGIN=false

# Brute-force / rate limits (login, invite register, API token probing)
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_REGISTER_MAX_FAILURES=10
AUTH_REGISTER_WINDOW_MINUTES=60
AUTH_REGISTER_LOCKOUT_MINUTES=30
AUTH_REGISTER_RATE_LIMIT_MAX=15
API_AUTH_MAX_FAILURES=40
API_AUTH_WINDOW_MINUTES=15
API_AUTH_LOCKOUT_MINUTES=15

# First-boot owner only (skipped once any owner exists). Prefer CLI:
#   npm run cli -- bootstrap-owner --email you@example.com --password '…'
# OWNER_BOOTSTRAP_EMAIL=
# OWNER_BOOTSTRAP_PASSWORD=
