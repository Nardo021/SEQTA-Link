[Unit]
Description=Seqta Link Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seqta-calendar
Group=seqta-calendar
WorkingDirectory=/opt/seqta-calendar/current
EnvironmentFile=/etc/seqta-calendar.env
ExecStart=/opt/seqta-calendar/venv/bin/gunicorn -w 1 -b 127.0.0.1:3210 run:app
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seqta-calendar
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
