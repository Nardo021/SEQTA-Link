{
  "name": "seqta-link",
  "version": "2.1.0",
  "description": "Seqta Link — self-hosted SEQTA timetable sync with iCalendar feed",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "cli": "tsx src/cli/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=1 test/unit/**/*.test.ts test/golden/**/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/**/*.test.ts",
    "build:userscript": "node Script/build.mjs",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.5.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.16.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "eslint": "^9.27.0",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
