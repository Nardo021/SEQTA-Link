# Local development
FLASK_ENV=development
HOST=0.0.0.0
PORT=3210

# SQLite database file (WAL mode enabled on startup)
DATABASE_PATH=./data/seqta.db

DEFAULT_TIMEZONE=Australia/Sydney
PUBLIC_BASE_URL=http://127.0.0.1:3210

# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_PEPPER=
UID_SECRET=
SESSION_SECRET=

LOG_LEVEL=info
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
AUTH_DEV_LOGIN=true

MAX_LESSONS_PER_SYNC=2000
MAX_SYNC_RANGE_DAYS=120

# Brute-force limits (login, pairing)
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15

# First-boot owner (optional; skipped once any owner exists)
# OWNER_BOOTSTRAP_EMAIL=owner@local.test
# OWNER_BOOTSTRAP_PASSWORD=OwnerPass123!
