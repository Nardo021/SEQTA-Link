{
  "name": "seqta-link-workers-compat-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run ui:build && vitest run",
    "build": "npm run ui:build && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "ui:build": "tailwindcss -i src/styles.css -o .generated/ui.css --minify && node scripts/embed-css.mjs && node scripts/embed-interactive.mjs",
    "test:browser": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "radix-ui": "^1.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "lucide-react": "^0.468.0",
    "cmdk": "1.1.1",
    "sonner": "2.0.7",
    "@tanstack/react-table": "8.21.3",
    "react-day-picker": "9.11.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/vitest-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "cf": "latest",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "1.56.1"
  }
}
