NODE_ENV=production
HOST=127.0.0.1
PORT=3210

# Login role should be able to SET ROLE to seqta_* API roles (see database/migrations/003_db_roles.sql).
DATABASE_URL=postgresql://seqta:seqta@127.0.0.1:5432/seqta_calendar

# Optional: dedicated URL for real-Postgres integration tests
# DATABASE_URL_TEST=postgresql://leo@127.0.0.1:5432/seqta_calendar_test

DEFAULT_TIMEZONE=Australia/Sydney
PUBLIC_BASE_URL=https://timetable.leoze.top

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_PEPPER=
UID_SECRET=

ALLOWED_ORIGINS=https://learn.masada.onseqtacloud.com

MAX_BODY_BYTES=2097152
MAX_LESSONS_PER_SYNC=2000
MAX_SYNC_RANGE_DAYS=120

CANCELLED_FEED_RETENTION_DAYS=14
DELETED_DATABASE_RETENTION_DAYS=90

LOG_LEVEL=info
TRUST_PROXY=true

# Session auth (defaults to TOKEN_PEPPER if unset)
SESSION_SECRET=
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
AUTH_DEV_LOGIN=true

# Authentik OIDC (optional — omit to use dev login locally)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
